# Copy this file to .env and set unique local values before starting MySQL.
# Never commit .env or use these example values in a hosted environment.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=attendance_tracker
DB_USER=attendance_app
DB_PASSWORD=replace-with-a-strong-local-app-password

# Backend API (local development)
API_PORT=3001
SESSION_TTL_DAYS=14
DB_POOL_SIZE=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
VITE_API_URL=http://localhost:3001/api
